# Database
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/legal_sakinah

# better-auth (BETTER_AUTH_SECRET minimal 32 karakter)
BETTER_AUTH_SECRET=ganti-dengan-string-acak-minimal-32-karakter
BETTER_AUTH_URL=http://localhost:3000

# Publik
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_WHATSAPP_NUMBER=6281234567890
NEXT_PUBLIC_WHATSAPP_PREFILL=
NEXT_PUBLIC_GA4_MEASUREMENT_ID=
NEXT_PUBLIC_META_PIXEL_ID=

# Opsional seed admin
SEED_ADMIN_EMAIL=admin@legalsakinah.local
SEED_ADMIN_PASSWORD=ganti-password-min-12-karakter
SEED_ADMIN_NAME=Admin Legal Sakinah

# Rate limit CTA
CTA_EVENT_RATE_LIMIT_PER_MINUTE=20

NODE_ENV=development
